{
  "name": "pradeep-portfolio",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://prad0202006.github.io/my_portfolio",
  "dependencies": {
    "autoprefixer": "^10.4.16",
    "axios": "^1.5.0",
    "emailjs-com": "^3.2.0",
    "framer-motion": "^10.16.4",
    "postcss": "^8.4.31",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "react-intersection-observer": "^9.5.2",
    "react-router-dom": "^6.16.0",
    "react-scripts": "5.0.1",
    "react-toastify": "^9.1.3",
    "socket.io-client": "^4.5.4",
    "tailwindcss": "^3.3.0"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "netlify-cli": "^17.0.0",
    "serve": "^14.2.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "build:analyze": "npm run build && npx serve -s build -l 3001",
    "deploy:netlify": "npm run build && netlify deploy --prod --dir=build",
    "deploy:vercel": "vercel --prod",
    "deploy:gh-pages": "gh-pages -d build",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
